# Gradle
.gradle/
build/
gradle-app.setting
.gradletasknamecache

# Android Studio / IntelliJ
.idea/
*.iml
local.properties
captures/

# 构建产物
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class
bin/
gen/
out/
release/

# 签名文件 —— 绝对不要入库
*.jks
*.keystore
keystore/
keystore.properties
signing.properties

# 成品归集目录（里面的 apk 已被上面的规则忽略）
dist/

# 测试夹具 APK —— 不是发布产物，但必须随仓库提交
# （上面 *.apk 会把它一起忽略，这里显式放行；见 tools/protocol-test/fixtures/README.md）
!tools/protocol-test/fixtures/*.apk

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
*.tmp
*.bak

# Python 字节码缓存（tools/ 下有探测与核验脚本，跑一次就会生成）
__pycache__/
*.pyc

# 西瓜的本地待办/工作上下文，不进公开仓库
.agent/
