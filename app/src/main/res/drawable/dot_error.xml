<?xml version="1.0" encoding="utf-8"?>
<!--
  未就绪 / 出错：红色。

  什么时候会是红的：
    · 组播没绑上 —— 这时手机根本搜不到设备，是最需要被看见的状态
    · 播放报错
    · 服务还没起来

  宁可让用户看到红点去查，也不要拿一个永远绿的圆点假装一切正常。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/dot_error" />
    <size android:width="10dp" android:height="10dp" />
</shape>
