<?xml version="1.0" encoding="utf-8"?>
<!--
  TV 界面布局。
  三条约束决定了它的样子：
    1) 观看距离 2~3 米 → 字体必须大，正文不低于 16sp
    2) 电视有 overscan（边缘可能被裁） → 四周留 48dp 安全边距
    3) 遥控器 D-pad 操作 → 按钮必须可聚焦、焦点态必须醒目
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 播放层：有投屏内容时全屏显示画面 -->
    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 音乐层：纯音频投屏时显示。
         为什么必须有这一层：音频流走的是同一个 SurfaceView，上面什么都没有 ——
         电视就是一片黑，只剩一条状态栏。声音明明在放，看着却像投屏失败了。
         所以纯音频时用一层**不透明**的卡片把它盖住（background=@color/bg 是
         必须的，透明的话下面的黑色还是会露出来）。 -->
    <LinearLayout
        android:id="@+id/music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingRight="48dp"
        android:visibility="gone">

        <!-- 封面：220dp 见方。取不到封面时它继续显示 ic_music 图标（src 兜底）——
             绝不留一个"加载中/取不到"的空白方块（空白块在深色卡片上看着像界面坏了）。
             fitCenter 而不是 fitXY：宁可留边，也不要把封面/图标拉变形。
             它画在**不透明**的音乐层之上，即便封面自带透明通道，透出的也是深色底，
             不是底下 SurfaceView 的蓝色。 -->
        <ImageView
            android:id="@+id/music_cover"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:contentDescription="@string/music_cover_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music" />

        <!-- 歌名：音乐层里**最大**的一行（32sp 粗体、主色）。
             原来这里最大的是写死的「音乐投屏」（34sp），而真正的歌名被挤在 17sp ——
             字号层级排反了。现在删掉那个静态大字，把主位还给歌名。 -->
        <TextView
            android:id="@+id/music_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- 歌手行：取不到时整行 GONE（不显示空行）。 -->
        <TextView
            android:id="@+id/music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/music_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <!-- 歌词行：DLNA 没有标准歌词字段，控制点不送就整行 GONE（不显示 = 现状）。
             maxLines + 省略号：歌词可能很长，不能撑爆布局。 -->
        <TextView
            android:id="@+id/music_lyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxLines="6"
            android:textColor="@color/text_hint"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/music_hint"
            android:textColor="@color/text_hint"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 图片层：投静态图时显示。
         为什么单开一层、不复用 SurfaceView：SurfaceView 上的内容是 MediaPlayer
         解码出来的，而它根本解不了静态图 —— 喂进去只会立刻报错、屏幕全黑。
         所以图片由 BitmapFactory 解码后画在这层 ImageView 上。
         背景必须**不透明**：图片常带透明通道（PNG、带蒙版的照片），
         不铺一层底的话，透明区域会露出下面那层视频 Surface 的蓝色。
         fitCenter 而不是 fitXY：电视上宁愿两侧留黑边，也不要把人脸拉变形。 -->
    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:contentDescription="@string/image_desc"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 主面板：等待投屏时显示。
         这里的 background 必须**不透明**，和上面 music 层是同一个道理：
         它底下压着 SurfaceView，而停止播放之后那个 Surface 可能残留一层
         平台特有的底色（老 MTK 上是蓝的）。面板透明的话底色会直接透出来，
         看起来就像"停止投屏把电视搞坏了"。 -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="48dp"
        android:paddingRight="48dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <!-- 标题行 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/status_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/dot_online" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="8dp"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_hint"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 引导卡片：左边是文字引导，右边是二维码 ——
             扫码这条路径比"在手机 App 里找投屏按钮"短得多：扫完就是上传页，
             传完一键播。所以码要够大（10:1 规则：3~5 米外要 30cm 以上）。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_title"
                    android:textColor="@color/accent"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/guide_body"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- 二维码整块（码 + 一行小字）。

                 整块有个 id 是为了能**整块隐藏**：位图是异步/按需生成的，
                 生成不出来时留一个空的白色方块在深色卡片上，看着像界面坏了。

                 白底是必须的（@color/qr_bg，见那边的注释）；码四周还留了
                 6dp 的 padding —— QrRenderer 里已经内建了 4 个模块的静区，
                 这一圈白边是第二道保险：静区被卡片底色吃掉，码就扫不出来了。 -->
            <LinearLayout
                android:id="@+id/qr_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/qr_image"
                    android:layout_width="196dp"
                    android:layout_height="196dp"
                    android:background="@color/qr_bg"
                    android:contentDescription="@string/qr_desc"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/qr_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 设备信息卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_device"
                    android:textColor="@color/text_hint"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/info_device"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_address"
                    android:textColor="@color/text_hint"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/info_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_network"
                    android:textColor="@color/text_hint"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/info_network"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_state"
                    android:textColor="@color/text_hint"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/info_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- 版本号：排障第一个要问的就是「盒子上到底是哪一版」。
                 内容来自 BuildConfig（build.gradle 的 versionName/versionCode），
                 不写死字面量 —— 写死就会出现「APK 是 0.1.9、界面还写着 0.1.8」
                 这种骗人的情况。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_version"
                    android:textColor="@color/text_hint"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/info_version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_source"
                    android:textColor="@color/text_hint"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/info_source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_restart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_selector"
                android:focusable="true"
                android:minWidth="160dp"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/btn_restart"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 播放状态浮层：只在播放时出现 -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/overlay"
        android:orientation="horizontal"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <!-- 这个点必须能被代码改颜色。原来是写死的 dot_online（绿），
             而顶部条现在只在「暂停 / 出错 / 缓冲」时出现 —— 出错时
             左边亮着一个绿点、右边写着「出错：…」，自己跟自己打架。
             面板上那个点早就改成说实话了，这里当时漏了。 -->
        <View
            android:id="@+id/overlay_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/dot_online" />

        <TextView
            android:id="@+id/playing_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
