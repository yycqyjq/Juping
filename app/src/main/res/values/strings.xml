<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">聚屏</string>
    <string name="app_subtitle">投屏接收端</string>

    <string name="label_device">设备名</string>
    <string name="label_address">地址</string>
    <string name="label_network">网络</string>
    <string name="label_state">状态</string>
    <string name="label_version">版本</string>
    <!-- 设备基础信息那 2×2 网格的四个格名。
         值全部是运行时读出来的（Build / /proc / statfs），不写死 ——
         写死就一定骗人（盒子换机型、系统升级后界面还印着旧值）。 -->
    <string name="label_system">系统</string>
    <string name="label_cpu">处理器</string>
    <string name="label_mem">内存</string>
    <string name="label_storage">存储</string>
    <string name="label_source">片源</string>

    <string name="guide_title">在手机上开始投屏</string>
    <string name="guide_body">打开手机 App 的投屏功能\n选择下面这个名字</string>

    <!-- 二维码那一块。文案只说"手机扫码"，因为码旁边就是地址 ——
         扫不出来的话照着上面那行地址手输也一样。 -->
    <string name="qr_hint">手机扫码\n传文件播放</string>
    <string name="qr_desc">上传页二维码</string>

    <!-- 通高二维码列（右列）：上标题 + 下说明。
         远距离先读到标题知道"这是给手机扫的"；走近才看下半段的
         操作步骤与功能范围。文案只写**真的做得到**的事：
         扫码传文件，或直接用手机自带投屏。 -->
    <string name="qr_top">手机扫码投屏</string>
    <string name="qr_body">① 手机与电视连同一个 Wi-Fi\n② 扫码打开上传页，选照片/视频/音乐\n③ 传完一键投放到电视\n\n手机自带的投屏功能里\n选本设备名，也能直接投</string>

    <string name="btn_restart">重启服务</string>

    <string name="state_starting">启动中…</string>
    <string name="state_waiting">等待投屏</string>
    <string name="state_service_down">服务未就绪</string>
    <string name="state_playing">正在播放</string>
    <string name="state_paused">已暂停</string>

    <!-- 带占位符的格式串。
         放进资源而不是在代码里拼字符串，是因为拼接出来的文本无法翻译，
         也无法适配从右到左的语言。 -->
    <string name="fmt_address">%1$s:%2$d</string>
    <!-- 版本号，取构建产物里的 versionName（不写死字面量）。
         versionCode 是给系统比较新旧用的整数，界面上不必出现 —— 用户看的是"版本 0.1.11"。 -->
    <string name="fmt_version">%1$s</string>
    <string name="fmt_progress">%1$s / %2$s</string>
    <string name="fmt_state_error">出错：%1$s</string>

    <!-- 播放错误的分类文案。
         每条都回答「用户接下来该做什么」，而不只是"哪里错了" ——
         原来界面上显示的是 "播放错误 what=1 extra=-1010" 这种原样字符串，
         用户既看不懂，也没法据此做任何决定。
         分类本身在 PlaybackPolicy（纯逻辑层，可脱离 Android 跑断言），
         文案在这里，两者分开：改措辞不动判据，改判据不动措辞。 -->
    <string name="err_connect">连不上媒体服务器，检查一下网络</string>
    <string name="err_server">服务器取不到这个内容，换一个试试</string>
    <string name="err_decode">这台盒子解不了这个格式</string>
    <string name="err_stalled">播放中断，正在重连</string>
    <string name="err_giveup">反复中断，已停止重连 —— 请重新投屏</string>
    <string name="err_unknown">播放出错</string>

    <string name="toast_restarted">服务已重启</string>
    <string name="toast_image_failed">这张图没能显示出来，换一张试试</string>
    <string name="notify_title">聚屏运行中</string>
    <string name="notify_text">等待投屏 · 点击打开界面</string>

    <!-- 图片投屏。
         MediaPlayer 解不了静态图（喂进去只会立刻报错、全黑），所以图片由
         BitmapFactory 解码后画在 ImageView 上，这条无障碍描述就属于那一层。 -->
    <string name="image_desc">正在展示的图片</string>

    <!-- 视频准备中的占位文案（MODE_VIDEO_PENDING）。
         老 MTK 平台上「没有内容的视频层」输出的是一屏蓝 —— prepare 窗口
         必须既藏掉 SurfaceView、又有一层不透明底替它说话。 -->
    <string name="video_wait">正在准备视频…</string>

    <!-- 音乐投屏。
         纯音频流在 SurfaceView 上什么都没有，电视就是一片黑 —— 声音明明在放，
         看着却像投屏坏了。所以纯音频时必须换成音乐形态，把这件事说清楚。
         歌名不再用固定标题：静态的「音乐投屏」既重复（整层就是音乐形态），
         又抢走了本该给歌名的视觉权重，所以删掉，让歌名占据主位。 -->
    <string name="music_live">正在播放</string>
    <string name="music_hint">声音正在播放 · 这个片源没有画面</string>
    <!-- 封面图的无障碍描述。封面是"这首歌的封面"（来自 upnp:albumArtURI），
         取不到时显示的是 ic_music 图标 —— 两种情况这条描述都成立。 -->
    <string name="music_cover_desc">歌曲封面</string>

    <!-- 主面板上的一句静态说明（2026-10-08 二夜拍板）。

         原来「画面编码不支持」「本机解码能力放不下这个清晰度」是**按流判断**、
         在顶部状态条上实时弹出的。但那两条都是**播放前的预测**：判错时会对一条
         能正常播的流喊超限，而且没有「画面其实出来了」的撤销回路 —— 提示一路
         赖到回主界面才熄。二夜的判断：投不上就投不上，不必每条流都替用户下结论。

         所以改成：诊断退回内部日志，对用户只在主面板上给一句**通用**的说明 ——
         不针对任何一条流，也就不存在误报。仍保留可执行动作（360P / H.264），
         只说"不支持"等于没说（与错误分类文案同一条纪律）。 -->
    <string name="hint_play_failed">投不上多半是清晰度或编码的问题\n在手机上改成 360P 或 H.264 再试</string>
</resources>
