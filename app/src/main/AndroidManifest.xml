<?xml version="1.0" encoding="utf-8"?>
<!--
  注意：这里刻意不写 <uses-sdk>。
  minSdk / targetSdk 只在 app/build.gradle 里声明一处 —— 两处都写的话，
  manifest 里的值会被 Gradle 静默覆盖（lint 报 GradleOverrides），
  以后改了一处忘了另一处，就会出现「明明改了却不生效」的怪事。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CHANGE_WIFI_MULTICAST_STATE 是 SSDP 的命门：
         没有它就拿不到 MulticastLock，收不到任何组播，
         表现就是「手机搜不到这台设备」，而代码看起来毫无问题。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 开机自启动 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 外接存储（U 盘 / SD）上的 APK 扫描与安装（批 3.5）。
         API 15 上读写外部存储只有 WRITE_EXTERNAL_STORAGE 这一个权限
         （READ_EXTERNAL_STORAGE 要到 API 16 才出现）—— 本功能只读不写，
         但老平台没有只读变体，只能声明它。READ_EXTERNAL_STORAGE 是为
         API 16+ 的设备准备的，在 API 15 上是 no-op（系统忽略不认识的名字），
         声明它无副作用。两条都是装机时授予（targetSdk 19 < 23，无运行期弹框）。
         权限面刻意保持最小：不加 INSTALL_PACKAGES / REQUEST_INSTALL_PACKAGES ——
         targetSdk 19 走 ACTION_VIEW 唤起系统安装器，本就不需要它们。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- 声明为 TV 应用：不需要触摸屏（遥控器操作），
         leanback 标记为可选，这样手机/平板也能装来调试。 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
      hardwareAccelerated="false" 是**刻意**关的，不是漏配。

      targetSdk >= 14 时系统默认开启硬件加速，所以这里必须显式关掉。
      理由：这台盒子（MediaTek MT5880 / Android 4.0.4）的 GPU 驱动是
      2012 年前后的版本，硬件加速的合成路径与 MediaPlayer 的视频层叠加时
      出过花屏 / 蓝色画面 —— 而 SurfaceView 本来就是独立图层，
      视频画面根本不经过应用的硬件加速通道，开了也只是让那层 UI 走 GPU。

      而界面本身只有几个 TextView 和两个 LinearLayout，软件渲染绰绰有余；
      换成硬件加速反而要在 0.6GB 内存上多养一块 GPU 显存。
      收益为零、风险为正，所以关掉。
    -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/ic_banner"
        android:hardwareAccelerated="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- exported=true 是必须的：有 intent-filter 的组件从 Android 12 起
             必须显式声明，否则直接装不上。这里它本来也是给启动器调用的。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Android TV 启动器入口；4.0 上不认识这个 category，但无害 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务承载整个接收端：DLNA 服务 + 播放器都挂在这里，
             这样切到后台甚至息屏也不会被系统回收。
             exported=false：没有任何外部组件需要调它，不对外暴露。 -->
        <service
            android:name=".DlnaRendererService"
            android:exported="false" />

        <!-- 开机自启动。注意：Android 3.1+ 起，应用必须被手动启动过至少一次，
             才能收到 BOOT_COMPLETED —— 这是系统限制，绕不过去。
             priority=1000 是为了在系统广播队列里排在前面，
             早点把服务拉起来，减少开机后「要等一会儿才能投屏」的空窗期。 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 设备改名（adb 广播通道），用法见 README「改名」一节：
             am broadcast 用 action com.juping.cast.APPLY_RENAME、extra "name" 传新名。
             exported=true 是必须的：am shell 广播来自 shell（root 级），不导出收不到。
             这是全项目唯一的 exported 指令面 —— 入口侧的清洗（控制字符/限长）
             在 RenameReceiver.sanitize，XML 侧的转义在 device.xml 生成处，两道护栏。 -->
        <receiver
            android:name=".RenameReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.juping.cast.APPLY_RENAME" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
