<?xml version="1.0" encoding="utf-8"?>
<!--
  注意：这里刻意不写 <uses-sdk>。
  minSdk / targetSdk 只在 app/build.gradle 里声明一处 —— 两处都写的话，
  manifest 里的值会被 Gradle 静默覆盖（lint 报 GradleOverrides），
  以后改了一处忘了另一处，就会出现「明明改了却不生效」的怪事。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CHANGE_WIFI_MULTICAST_STATE 是 SSDP 的命门：
         没有它就拿不到 MulticastLock，收不到任何组播，
         表现就是「手机搜不到这台设备」，而代码看起来毫无问题。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 开机自启动 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 声明为 TV 应用：不需要触摸屏（遥控器操作），
         leanback 标记为可选，这样手机/平板也能装来调试。 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/ic_banner"
        android:hardwareAccelerated="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- exported=true 是必须的：有 intent-filter 的组件从 Android 12 起
             必须显式声明，否则直接装不上。这里它本来也是给启动器调用的。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Android TV 启动器入口；4.0 上不认识这个 category，但无害 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务承载整个接收端：DLNA 服务 + 播放器都挂在这里，
             这样切到后台甚至息屏也不会被系统回收。
             exported=false：没有任何外部组件需要调它，不对外暴露。 -->
        <service
            android:name=".DlnaRendererService"
            android:exported="false" />

        <!-- 开机自启动。注意：Android 3.1+ 起，应用必须被手动启动过至少一次，
             才能收到 BOOT_COMPLETED —— 这是系统限制，绕不过去。
             priority=1000 是为了在系统广播队列里排在前面，
             早点把服务拉起来，减少开机后「要等一会儿才能投屏」的空窗期。 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
